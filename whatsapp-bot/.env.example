# Sitenin adresi. Menü kartlarının görüntüsü buradan alınır ve mesajın altına link olarak eklenir.
SITE_URL=https://yemeklist.vercel.app

# Görüntü tasarımı: acik (sitenin açık teması), koyu (sitenin koyu teması), renkli (her güne ayrı renk)
TASARIM=acik

# Mesajın gideceği grubun kimliği. "npm run gruplar" ile öğrenebilirsin (…@g.us ile biter).
GROUP_ID=

# Gönderim zamanı (cron biçimi, Türkiye saati). Varsayılan: her pazartesi 09:30
# Pazar akşamı göndermek istersen: 0 20 * * 0  (hafta sonu çalışırsa gelecek haftanın menüsünü atar)
CRON=30 9 * * 1

# --- Sadece Green API (GitHub Actions) yöntemi için ---
# Green API panelindeki apiUrl, ör. https://7105.api.greenapi.com
GREEN_API_URL=https://api.green-api.com
# Green API panelindeki mediaUrl (resim yükleme adresi), ör. https://7105.media.green-api.com
GREEN_API_MEDIA_URL=
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=
