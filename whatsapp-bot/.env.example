# Mesajın gideceği grubun kimliği. "npm run gruplar" ile öğrenebilirsin (…@g.us ile biter).
GROUP_ID=

# Gönderim zamanı (cron biçimi, Türkiye saati). Varsayılan: hafta içi her gün 10:30
CRON=30 10 * * 1-5

# İsteğe bağlı: mesajın sonuna eklenecek site linki
SITE_URL=

# İsteğe bağlı: menüyü her seferinde GitHub'dan en güncel haliyle çek (git pull gerekmez)
MENU_SOURCE_URL=https://raw.githubusercontent.com/bakituna25/yemekhanebaki/main/src/App.jsx

# --- Sadece Green API (GitHub Actions) yöntemi için ---
GREEN_API_URL=https://api.green-api.com
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=
